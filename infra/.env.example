# infra/docker-compose.vllm.yml 용 환경 변수 예시.
# 실제 값은 infra/.env로 복사해서 사용하세요(.env는 Git에 커밋하지 않습니다).

# RTX 4060 8GB VRAM 기준 기본값 - 필요시 조정하세요.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_SERVED_MODEL_NAME=airead-literacy
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_NUM_SEQS=2

# 게이트(gated) 모델을 사용할 경우에만 필요. 공개 모델은 비워 두세요.
HUGGING_FACE_HUB_TOKEN=
