# WAS(Node) 서버 환경 변수 예시. 실제 값은 .env로 복사해 사용하세요(.env는 Git에 커밋하지 않습니다).

# 기존 서버 설정
PORT=3000
NODE_ENV=development
DB_DIR=
DB_PATH=
TEACHER_PASSWORD=0000

# vLLM 연동 설정 (infra/docker-compose.vllm.yml로 띄운 서버를 가리킵니다)
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=airead-literacy
LLM_TIMEOUT_MS=60000
# vLLM 응답이 없거나 스키마 검증에 실패했을 때 규칙 기반 evaluator.js로 자동 폴백할지 여부
LLM_FALLBACK_TO_RULE=true

# 국립중앙도서관 '사서추천도서' Open API 연동 설정
# 활용신청(인증키 발급) 페이지: https://www.data.go.kr/data/15064371/openapi.do
NL_OPEN_API_KEY=
NL_OPEN_API_BASE_URL=https://www.nl.go.kr/NL/search/openApi/saseoApi.do
NL_OPEN_API_TIMEOUT_MS=10000
